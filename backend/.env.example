# Salin menjadi .env lalu isi. Jangan pernah meng-commit .env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mib_db?schema=public"

# Rahasia penanda sesi (acak, panjang). Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Agen AI
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Kedalaman berpikir agen: low | medium | high (bawaan) | xhigh | max. Makin tinggi makin teliti, tapi makin lambat dan mahal.
# AGENT_EFFORT=high
# Batas langkah (panggilan alat) per perintah, sebagai pengaman agar agen tidak berputar tanpa henti. Bawaan 30.
# AGENT_MAX_TURNS=30
# Kedalaman berpikir khusus Mode Meeting (bawaan medium agar suara tidak terlalu lama menunggu).

# --- Login dengan Google (opsional; tombol tampil, tapi baru berfungsi bila keduanya terisi) ---
# 1. https://console.cloud.google.com/apis/credentials  ->  Create credentials  ->  OAuth client ID
# 2. Application type: Web application
# 3. Authorized JavaScript origins   : http://localhost:3000   (di produksi: domain frontend Anda)
# 4. Authorized redirect URIs        : http://localhost:4000/auth/google/callback
#    (di produksi: https://API-ANDA/auth/google/callback; samakan dengan GOOGLE_REDIRECT_URI bila diisi)
# 5. Salin Client ID dan Client secret ke bawah ini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Aplikasi lokal di komputer pengguna: mengaktifkan kendali komputer (mouse/keyboard/layar, hanya Windows)
# dan menjadikan pengguna pertama admin. JANGAN aktifkan di server bersama.
# MIB_LOCAL=1
